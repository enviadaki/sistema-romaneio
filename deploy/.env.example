# Copy this file to .env on the server and fill in real values.
# .env is gitignored - never commit real secrets.

# --- Postgres (used by the postgres container itself) ---
POSTGRES_USER=romaneio
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=romaneios

# --- Database URL the API server connects with ---
# Must match the POSTGRES_* values above. "postgres" is the service name
# from docker-compose.yml (containers reach each other by service name).
DATABASE_URL=postgresql://romaneio:troque-por-uma-senha-forte@postgres:5432/romaneios

# --- Clerk (authentication) ---
CLERK_SECRET_KEY=sk_test_or_live_...
CLERK_PUBLISHABLE_KEY=pk_test_or_live_...

# --- App secrets (same values used on Replit) ---
SESSION_SECRET=
ARCO_API_KEY=
ADMIN_EMAILS=rafaelenviadaki@gmail.com

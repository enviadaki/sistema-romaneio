{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#fafafa" },
      "foreground": { "$value": "#1a1a1a" },
      "border": { "$value": "#e6e6e6" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#1a1a1a" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#1a1a1a" },
      "primary": {
        "$value": "#35a6de",
        "$description": "Envia Daki blue-cyan. Drives primary actions, links, focus and active navigation."
      },
      "primaryForeground": { "$value": "#0a1720" },
      "secondary": { "$value": "#f0f0f0" },
      "secondaryForeground": { "$value": "#1a1a1a" },
      "muted": { "$value": "#f0f0f0" },
      "mutedForeground": { "$value": "#666666" },
      "accent": { "$value": "#35a6de" },
      "accentForeground": { "$value": "#0a1720" },
      "destructive": { "$value": "#ef4444" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#e6e6e6" },
      "ring": { "$value": "#35a6de" },
      "chart1": { "$value": "#35a6de" },
      "chart2": { "$value": "#0ea5a4" },
      "chart3": { "$value": "#f59e0b" },
      "chart4": { "$value": "#7c3aed" },
      "chart5": { "$value": "#ef4444" },
      "sidebar": { "$value": "#121212" },
      "sidebarForeground": { "$value": "#fafafa" },
      "sidebarBorder": { "$value": "#262626" },
      "sidebarPrimary": { "$value": "#35a6de" },
      "sidebarPrimaryForeground": { "$value": "#0a1720" },
      "sidebarAccent": { "$value": "#262626" },
      "sidebarAccentForeground": { "$value": "#fafafa" },
      "sidebarRing": { "$value": "#35a6de" }
    },
    "dark": {
      "background": { "$value": "#121212" },
      "foreground": { "$value": "#fafafa" },
      "border": { "$value": "#262626" },
      "card": { "$value": "#1a1a1a" },
      "cardForeground": { "$value": "#fafafa" },
      "popover": { "$value": "#1a1a1a" },
      "popoverForeground": { "$value": "#fafafa" },
      "primary": { "$value": "#35a6de" },
      "primaryForeground": { "$value": "#0a1720" },
      "secondary": { "$value": "#262626" },
      "secondaryForeground": { "$value": "#fafafa" },
      "muted": { "$value": "#262626" },
      "mutedForeground": { "$value": "#a6a6a6" },
      "accent": { "$value": "#35a6de" },
      "accentForeground": { "$value": "#0a1720" },
      "destructive": { "$value": "#7f1d1d" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#262626" },
      "ring": { "$value": "#35a6de" },
      "chart1": { "$value": "#35a6de" },
      "chart2": { "$value": "#2dd4bf" },
      "chart3": { "$value": "#fbbf24" },
      "chart4": { "$value": "#a78bfa" },
      "chart5": { "$value": "#fb7185" },
      "sidebar": { "$value": "#121212" },
      "sidebarForeground": { "$value": "#fafafa" },
      "sidebarBorder": { "$value": "#262626" },
      "sidebarPrimary": { "$value": "#35a6de" },
      "sidebarPrimaryForeground": { "$value": "#0a1720" },
      "sidebarAccent": { "$value": "#262626" },
      "sidebarAccentForeground": { "$value": "#fafafa" },
      "sidebarRing": { "$value": "#35a6de" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "sans-serif"],
        "$description": "Default UI and body typeface, matching the Sistema de Romaneios."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.5rem",
      "$description": "Base corner radius; sm/md/lg/xl derive from this in the theme."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
